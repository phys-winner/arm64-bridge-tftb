 namespace Dynarmic::Backend::Arm64 {
 
+#if defined(DYNARMIC_ENABLE_ARM64_PERF_MAP)
+namespace {
+
+#    if !defined(DYNARMIC_ARM64_PERF_MAP_DIRECTORY)
+#        define DYNARMIC_ARM64_PERF_MAP_DIRECTORY "/data/local/tmp"
+#    endif
+
+std::mutex perf_map_mutex;
+std::FILE* perf_map_file = nullptr;
+bool perf_map_open_attempted = false;
+size_t perf_map_registration_count = 0;
+
+void PerfMapRegister(const void* start, size_t size, const char* friendly_name) {
+    if (size == 0) {
+        return;
+    }
+
+    std::lock_guard guard{perf_map_mutex};
+    if (!perf_map_open_attempted) {
+        perf_map_open_attempted = true;
+        char path[512];
+        const int path_length = std::snprintf(path, sizeof(path), "%s/perf-%d.map",
+                                              DYNARMIC_ARM64_PERF_MAP_DIRECTORY, getpid());
+        if (path_length <= 0 || static_cast<size_t>(path_length) >= sizeof(path)) {
+            std::fprintf(stderr, "Dynarmic ARM64 perf-map path is too long\n");
+            return;
+        }
+
+        perf_map_file = std::fopen(path, "w");
+        if (!perf_map_file) {
+            std::fprintf(stderr, "Dynarmic ARM64 perf-map open failed: %s\n", path);
+            return;
+        }
+        std::setvbuf(perf_map_file, nullptr, _IOFBF, 64 * 1024);
+        std::fprintf(stderr, "Dynarmic ARM64 perf-map: %s\n", path);
+    }
+    if (!perf_map_file) {
+        return;
+    }
+
+    const auto address = reinterpret_cast<std::uintptr_t>(start);
+    std::fprintf(perf_map_file, "0x%016" PRIxPTR " 0x%zx %s\n", address, size, friendly_name);
+    ++perf_map_registration_count;
+    if (perf_map_registration_count == 1 || perf_map_registration_count % 64 == 0) {
+        std::fflush(perf_map_file);
+    }
+}
+
+}  // anonymous namespace
+#endif
